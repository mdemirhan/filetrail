{
  "name": "@filetrail/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "build:icon": "bash ./scripts/build-app-icon.sh",
    "build:native": "cd ../../packages/native-fs && npx node-gyp rebuild",
    "start": "bash ./scripts/start.sh",
    "start:verbose": "bash ./scripts/start.sh --verbose",
    "test:smoke": "playwright test --config ./e2e/playwright.config.ts",
    "make:mac": "bash ./scripts/make-macos-app.sh",
    "make:mac:notarized": "bash ./scripts/make-macos-app.sh --notarize",
    "make:mac:adhoc": "bash ./scripts/make-macos-app.sh --adhoc"
  },
  "dependencies": {
    "@filetrail/contracts": "workspace:*",
    "@filetrail/native-fs": "workspace:*",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "playwright": "^1.60.0",
    "png2icons": "^2.0.1"
  }
}
