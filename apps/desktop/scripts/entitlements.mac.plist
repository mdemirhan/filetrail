<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- V8 JIT-compiles in the main and renderer processes; the hardened
	     runtime forbids writable+executable memory without this entitlement.
	     Electron >= 12 needs only allow-jit (no unsigned-executable-memory). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
